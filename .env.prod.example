# Serverda: cp .env.prod.example .env  va qiymatlarni to'ldiring (server-setup.sh buni o'zi qiladi)
DJANGO_SETTINGS_MODULE=config.settings.prod
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE_ME

DJANGO_ALLOWED_HOSTS=api.example.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.uz
# HTTPS hali sozlanmagan bo'lsa (certbot'dan oldin) — False
DJANGO_HTTPS=True

# openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=shoeflow
POSTGRES_USER=shoeflow
DATABASE_URL=postgres://shoeflow:CHANGE_ME@db:5432/shoeflow
REDIS_URL=redis://redis:6379/0

# gunicorn faqat 127.0.0.1 da shu portda ochiladi, tashqaridan nginx orqali
WEB_PORT=8010
GUNICORN_WORKERS=2
CORS_ALLOWED_ORIGINS=
